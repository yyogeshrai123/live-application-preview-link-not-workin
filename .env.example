# ==============================================================================
# A ONE FINANCIAL SERVICES - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-change-in-production-a-one-financial-2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aone_financial_crm?schema=public

# External Integrations (Configuration ready - pending production credentials)
# SMS Gateway (e.g., Twilio / Fast2SMS)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=AONEFS

# WhatsApp Business API
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="A ONE FINANCIAL SERVICES <noreply@aonefinancial.com>"

# Object Storage (AWS S3 / Cloudflare R2 for Private KYC Documents)
STORAGE_ENDPOINT=
STORAGE_BUCKET=aone-kyc-documents-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Banking / Verification Webhooks (Read-only status updates)
BANK_WEBHOOK_SECRET=
